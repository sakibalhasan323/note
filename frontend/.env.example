# Note FRONTEND - all configuration is set here at build time (no admin panel).

# 1) OPTIONAL backend API (only needed for advanced branding/settings serving).
# Set this only if you deployed the /backend API. Leave empty to use the app
# without any backend.
VITE_API_URL="https://your-api.onrender.com"

# 2) YOUR Firebase web app configuration (from Firebase Console -> Project
# settings -> Your apps -> Web app). All values must be set to use Google
# sign-in + cloud sync. Leave blank to compile with the bundled default demo
# Firebase project (note-site-je).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# 3) Branding (optional). Defaults: name "Note", logo/favicon from assets.
VITE_WEBSITE_NAME="Note"
VITE_LOGO="/assets/logo.png"
VITE_FAVICON="/assets/favicon.png"
VITE_PRIMARY_COLOR="#c15f3c"